#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

    layers {
        layer_0 {
            bindings = <
                &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT &kp RBKT &kp DEL
                &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT  &kp ENTER
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp INT1 &kp UP &kp RSHFT
                &kp LCTRL  &kp LWIN  &mt LALT INT_MUHENKAN  &lt 1 SPACE  &kp INT_HENKAN  &mt RCTRL INT_KANA  &kp LEFT  &kp DOWN  &kp RIGHT
                >;
            };

        layer_1 {
            bindings = <
                &kp LANG5  &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp BSPC
                &bt BT_CLR &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp Y &kp U  &kp I  &kp O  &kp P  &kp LBKT &kp RBKT &kp DEL
                &kp LANG2 &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT  &kp ENTER
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp INT1 &kp PG_UP &kp RSHFT
                &kp LCTRL  &kp LWIN  &mt LALT INT_MUHENKAN  &lt 1 SPACE  &kp INT_HENKAN  &mt RCTRL INT_KANA  &kp HOME  &kp PG_DOWN  &kp END
                >;
            };
        };
    };
};
